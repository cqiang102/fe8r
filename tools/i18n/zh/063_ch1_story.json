{
  "2281": [
    "塔娜大人！", "古拉德军已经逼近到眼前了。", "咦，这么快？",
    "怎、怎么办……", "以这座城的兵力守不住。", "请塔娜大人回王都去。",
    "那不行", "我还没找到艾莉卡她们呢……", "艾莉卡是我的朋友。",
    "我必须去救她……", "对了！父王……", "不，请向弗雷利亚王请求援军。",
    "是！", "艾莉卡，一定要平安……"
  ],
  "2282": [
    "布雷格大人，看来敌人", "打算据城固守。", "……", "哼。",
    "凭那点守备，就想挡住我们古拉德军", "吗？", "要如何处置？",
    "你们就在那里看着。", "由我亲自去把它砸个稀烂！", "是！"
  ],
  "2284": [
    "住、住手！", "若你们再施暴，", "就由我来当你们的对手。",
    "嗯？你是什么人？", "我、我是塔娜。", "弗雷利亚王国的公主。",
    "不许你们再在我国", "肆意妄为。", "哦？弗雷利亚的公主。",
    "这可正合我意……", "滚出这座城。", "若我有个三长两短，父王和",
    "兄长绝不会饶过你们……", "哼……听说弗雷利亚王海登",
    "对女儿极为溺爱。", "拿你当人质，就能轻易", "攻下弗雷利亚。",
    "喂，把这女人", "关进牢里！", "是！", "不要！", "放、放开我……"
  ],
  "2287": ["艾莉卡大人，请下命令。"],
  "2288": [
    "嗯？那是雷奈斯的公主吗？", "哈哈哈，我运气真好！",
    "功劳自己送上门来了。", "喂，你们几个！", "把那小丫头给我抓来！"
  ],
  "2290": [
    "多谢。", "不，哪里的话。", "我还在见习的时候",
    "曾受教于雷奈斯骑士团的赛特将军。",
    "即使武艺未成，也有拯救同伴的", "重要职责——将军这样说过……",
    "啊……？", "怎么了？", "那、那个骑影是……赛特将军！？",
    "而且，那位是……", "艾莉卡大人！"
  ],
  "2291": [
    "您、您没事吧，吉利亚姆大人？", "擦伤而已。",
    "对、对了，我身上带着", "伤药！", "我现在就给您送过去！"
  ],
  "2292": ["找到了！是雷奈斯的残党。", "别让他跑了！"],
  "2293": ["啧，一个两个", "都是废物！"],
  "2294": ["什、什么……", "我竟然……"],
  "2297": [
    "艾莉卡大人", "您平安无事，太好了！", "弗朗茨，你也平安无事……",
    "是、是！", "我在弗雷利亚领遇到吉利亚姆大人，", "正在向他说明情况……",
    "那时听说国境的米乌兰城里", "弗雷利亚公主塔娜大人有危险，",
    "便慌忙与吉利亚姆大人赶来这里……", "塔娜在这里……？",
    "弗朗茨，快走吧。", "是！"
  ],
  "2298": [
    "弗朗茨啊，你平安无事。", "是、是……赛特将军也……",
    "只要有将军在，", "我们雷奈斯骑士团绝不会输！",
    "弗朗茨，与我一同", "守护艾莉卡大人。", "出发。", "是，将军！"
  ],
  "2299": [
    "古拉德军那些家伙", "好像已经压制了城堡。",
    "待在城门上还能回血，", "守起来很方便。",
    "反过来说，要攻下", "就相当困难了……"
  ],
  "2300": [
    "占据那座城的", "重装骑士……", "似乎穿着相当坚固的", "铠甲。",
    "用普通武器的话", "很难打倒吧。",
    "记得用刺剑或破甲剑这类武器", "就能造成很大伤害。"
  ]
}
