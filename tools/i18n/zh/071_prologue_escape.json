{
  "2250": ["我名乃", "【月长石】之瓦尔特。", "古拉德帝国将军之一，", "你，就让我吃掉吧。"],
  "2253": [
    "艾莉卡大人，这边。", "看不到古拉德兵的身影。", "逃到这里",
    "暂且安全了吧。", "途中的失礼，还请您宽恕。", "不，赛特。",
    "若不是有你在，", "我根本无法从城中逃出……",
    "我如今能活下来，全靠你，", "真的非常感谢。", "而且为了护我，",
    "你竟受了这么重的伤……", "该找个地方处理伤口……", "这点伤",
    "不碍事。", "比起这个，艾莉卡大人。", "我们必须尽快赶往弗雷利亚。",
    "为了让法德大人的遗志", "不被白白浪费……", "……",
    "留在城里的父王……", "可还平安？", "还有在前线失去联络的",
    "兄长也……", "法德大人，艾夫拉姆大人是强大之人。",
    "纵使对手是古拉德皇帝，", "那两位也不会落于下风。", "比起这个，艾莉卡大人，现在",
    "请您先考虑保护自身。", "您若有万一，", "那两位该有多悲伤。",
    "为了活着与他们重逢，", "现在必须抵达弗雷利亚。", "是、是啊……",
    "直到与父王和兄长重逢之时", "我不能一直低着头。", "走吧，赛特。"
  ],
  "2256": [
    "雷奈斯的残兵败将，", "休想逃掉！", "是古拉德的追兵吗……",
    "艾莉卡大人，请退后。", "我没事，赛特。", "我受过兄长的剑术指导。",
    "我也要战！"
  ],
  "2258": ["接下来由我挡住。", "艾莉卡大人请先前往弗雷利亚领。"],
  "2259": ["这样，剩下的就只有敌将了……"],
  "2260": ["什、什么？", "区区残兵竟敢放肆……", "哼，既然如此，",
            "就让本将亲手了结你！"],
  "2261": ["唔……", "赛特！", "果然伤口……", "哼，到此为止了！",
            "住手！", "你的对手是我！"],
  "2262": ["先从你这家伙", "开始了结！"],
  "2263": ["什、什么……？"]
}
