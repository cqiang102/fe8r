{
  "2283": ["在我这杆枪面前", "也不过如此！　哈哈哈！"],
  "2285": [
    "赛特！", "那个……", "古拉德的手终于伸到弗雷利亚了……",
    "艾莉卡大人，这里危险。", "绕过米乌兰城，", "前往弗雷利亚王都吧。",
    "可是，我不能就这样视而不见……", "我们的雷奈斯", "被古拉德军侵略时……",
    "百姓们遭到古拉德士兵", "极其残酷的对待，我听说了。",
    "房屋被毁，财物被夺，女子被掳", "抵抗者尽数被处刑……",
    "……", "拜托了，赛特。", "我不想再看到人们",
    "遭受古拉德军暴虐的情景……", "……", "明白了。",
    "那么，先夺回米乌兰城吧。", "但是，艾莉卡大人",
    "请您千万不要勉强。", "我知道，赛特。", "走吧！"
  ],
  "2286": ["赛特", "我去那户人家", "打听一下米乌兰城的情况。"],
  "2289": [
    "吉利亚姆大人。", "那就是弗雷利亚的米乌兰城吗？", "没错。",
    "塔娜大人应该就在那座城里。", "可是，且不说刚才交战的古拉德兵，",
    "城周围只见得到古拉德兵的身影。", "城内的弗雷利亚军……",
    "难道已经来不及了吗……", "不，还说不准。",
    "若他们打算拿塔娜大人做交易，", "就不会要她的命。",
    "我们弗雷利亚东部国境守备队", "一定会救出她。", "是、是啊……",
    "与其放弃，不如行动。", "总之要尽快夺回城，",
    "然后去救艾莉卡大人……", "由守备力强的我打头阵。", "掩护就交给你了。"
  ],
  "2295": [
    "塔娜大人。", "吉利亚姆。", "对不起。", "给你添麻烦了……",
    "不，哪里的话。", "塔娜！", "……", "艾莉卡！？",
    "啊啊，真的是艾莉卡！", "塔娜", "你怎么会在这里？",
    "我听说雷奈斯陷落了，", "担心得不得了……",
    "不过，你真的平安无事，太好了……", "啊……艾夫拉姆呢？",
    "艾夫拉姆没事吗？", "兄长他……", "是吗……还没能联络上啊……",
    "但愿他平安无事……", "总之先去弗雷利亚城吧。",
    "父王或许知道些什么。", "谢谢你，塔娜。"
  ],
  "2296": [
    "艾莉卡！", "塔娜！？", "你怎么会在这里？",
    "我听说雷奈斯陷落了，", "担心得不得了……",
    "不过，你真的平安无事，太好了……", "塔娜大人也平安无事，太好了。",
    "赛特！你也平安无事啊！", "啊……艾夫拉姆呢？", "艾夫拉姆没事吗？",
    "兄长他……", "艾夫拉姆大人至今下落不明。",
    "是吗……还没能联络上啊……", "但愿他平安无事……",
    "总之先去弗雷利亚城吧。", "父王或许知道些什么。", "谢谢你，塔娜。"
  ]
}
