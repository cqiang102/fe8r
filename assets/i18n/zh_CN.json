  "2254": [
   "越过前面的桥就是弗雷利亚领地了。",
   "国境上的米乌兰城也近了。",
   "走吧，艾莉卡大人。"
  ],
  "2255": [
   "艾莉卡大人，为防万一",
   "请带上这把刺剑。",
   "若我有个万一，请您",
   "至少艾莉卡大人要前往弗雷利亚……"
  ],
  "2257": [
   "艾莉卡大人！",
   "我没事。总算是躲开了。",
   "这次换我们进攻！"
  ],
  "2264": [
   "艾莉卡大人，您受伤了吗？",
   "啊……",
   "不……",
   "我没事的，赛特。",
   "可是，您的脸色……",
   "没事的。没事……",
   "……",
   "这就是……战争吧。",
   "和与兄长、里昂切磋时",
   "完全不同……",
   "不杀死敌人，就无法活下去。",
   "人心无法相通，唯有力量主宰的",
   "悲哀世界……",
   "为什么古拉德帝国要发动这样的战争……",
   "艾莉卡大人……",
   "……",
   "我没事。",
   "我不会认输。",
   "走吧，赛特。",
   "夺回失去的祖国，",
   "直到与父王和兄长重逢的那一天",
   "我绝不会气馁。"
  ],
  "2274": [
   "本章只要打倒敌军的首领",
   "就算通关。",
   "通关条件",
   "会显示在画面",
   "的一角。",
   "建议每张地图都确认一下。",
   "那么，去",
   "攻击",
   "敌人吧。"
  ],
  "2275": [
   "艾莉卡",
   "上移动光标，",
   "Ａ键",
   "请按下。"
  ],
  "2283": [
   "在我这杆枪面前",
   "也不过如此！　哈哈哈！"
  ],
  "2285": [
   "赛特！",
   "那个……",
   "古拉德的手终于伸到弗雷利亚了……",
   "艾莉卡大人，这里危险。",
   "绕过米乌兰城，",
   "前往弗雷利亚王都吧。",
   "可是，我不能就这样视而不见……",
   "我们的雷奈斯",
   "被古拉德军侵略时……",
   "百姓们遭到古拉德士兵",
   "极其残酷的对待，我听说了。",
   "房屋被毁，财物被夺，女子被掳",
   "抵抗者尽数被处刑……",
   "……",
   "拜托了，赛特。",
   "我不想再看到人们",
   "遭受古拉德军暴虐的情景……",
   "……",
   "明白了。",
   "那么，先夺回米乌兰城吧。",
   "但是，艾莉卡大人",
   "请您千万不要勉强。",
   "我知道，赛特。",
   "走吧！"
  ],
  "2286": [
   "赛特",
   "我去那户人家",
   "打听一下米乌兰城的情况。"
  ],
  "2289": [
   "吉利亚姆大人。",
   "那就是弗雷利亚的米乌兰城吗？",
   "没错。",
   "塔娜大人应该就在那座城里。",
   "可是，且不说刚才交战的古拉德兵，",
   "城周围只见得到古拉德兵的身影。",
   "城内的弗雷利亚军……",
   "难道已经来不及了吗……",
   "不，还说不准。",
   "若他们打算拿塔娜大人做交易，",
   "就不会要她的命。",
   "我们弗雷利亚东部国境守备队",
   "一定会救出她。",
   "是、是啊……",
   "与其放弃，不如行动。",
   "总之要尽快夺回城，",
   "然后去救艾莉卡大人……",
   "由守备力强的我打头阵。",
   "掩护就交给你了。"
  ],
  "2295": [
   "塔娜大人。",
   "吉利亚姆。",
   "对不起。",
   "给你添麻烦了……",
   "不，哪里的话。",
   "塔娜！",
   "……",
   "艾莉卡！？",
   "啊啊，真的是艾莉卡！",
   "塔娜",
   "你怎么会在这里？",
   "我听说雷奈斯陷落了，",
   "担心得不得了……",
   "不过，你真的平安无事，太好了……",
   "啊……艾夫拉姆呢？",
   "艾夫拉姆没事吗？",
   "兄长他……",
   "是吗……还没能联络上啊……",
   "但愿他平安无事……",
   "总之先去弗雷利亚城吧。",
   "父王或许知道些什么。",
   "谢谢你，塔娜。"
  ],
  "2296": [
   "艾莉卡！",
   "塔娜！？",
   "你怎么会在这里？",
   "我听说雷奈斯陷落了，",
   "担心得不得了……",
   "不过，你真的平安无事，太好了……",
   "塔娜大人也平安无事，太好了。",
   "赛特！你也平安无事啊！",
   "啊……艾夫拉姆呢？",
   "艾夫拉姆没事吗？",
   "兄长他……",
   "艾夫拉姆大人至今下落不明。",
   "是吗……还没能联络上啊……",
   "但愿他平安无事……",
   "总之先去弗雷利亚城吧。",
   "父王或许知道些什么。",
   "谢谢你，塔娜。"
  ],
  "2238": [
   "要撤退吗？　　"
  ],
  "2239": [
   "要前往下一层吗？"
  ],
  "2201": [
   "贾哈那王宫",
   "在古拉德帝国面前陷落了。",
   "赶赴增援的罗斯顿圣骑士团",
   "也抵挡不住帝国将军瓦尔特而全军覆没。",
   "被留下的艾莉卡一行人",
   "拼死杀开血路，逃入沙漠……",
   "帝国将军瓦尔特与凯塞尔达毫不留情",
   "倾全军追击艾莉卡。",
   "在执拗的包围之下，艾莉卡",
   "已被彻底逼入绝境……"
  ],
  "2203": [
   "王都雷奈斯。",
   "久别归来的故乡，战后仍历历在目，",
   "令艾莉卡与艾夫拉姆心痛不已。",
   "守卫王都的是",
   "原雷奈斯骑士奥尔森。",
   "背叛雷奈斯、",
   "将艾莉卡诱入陷阱的叛徒……",
   "立誓复兴祖国，",
   "艾莉卡重返王都雷奈斯。"
  ],
  "2281": [
   "塔娜大人！",
   "古拉德军已经逼近到眼前了。",
   "咦，这么快？",
   "怎、怎么办……",
   "以这座城的兵力守不住。",
   "请塔娜大人回王都去。",
   "那不行",
   "我还没找到艾莉卡她们呢……",
   "艾莉卡是我的朋友。",
   "我必须去救她……",
   "对了！父王……",
   "不，请向弗雷利亚王请求援军。",
   "是！",
   "艾莉卡，一定要平安……"
  ],
  "2282": [
   "布雷格大人，看来敌人",
   "打算据城固守。",
   "……",
   "哼。",
   "凭那点守备，就想挡住我们古拉德军",
   "吗？",
   "要如何处置？",
   "你们就在那里看着。",
   "由我亲自去把它砸个稀烂！",
   "是！"
  ],
  "2284": [
   "住、住手！",
   "若你们再施暴，",
   "就由我来当你们的对手。",
   "嗯？你是什么人？",
   "我、我是塔娜。",
   "弗雷利亚王国的公主。",
   "不许你们再在我国",
   "肆意妄为。",
   "哦？弗雷利亚的公主。",
   "这可正合我意……",
   "滚出这座城。",
   "若我有个三长两短，父王和",
   "兄长绝不会饶过你们……",
   "哼……听说弗雷利亚王海登",
   "对女儿极为溺爱。",
   "拿你当人质，就能轻易",
   "攻下弗雷利亚。",
   "喂，把这女人",
   "关进牢里！",
   "是！",
   "不要！",
   "放、放开我……"
  ],
  "2287": [
   "艾莉卡大人，请下命令。"
  ],
  "2288": [
   "嗯？那是雷奈斯的公主吗？",
   "哈哈哈，我运气真好！",
   "功劳自己送上门来了。",
   "喂，你们几个！",
   "把那小丫头给我抓来！"
  ],
  "2290": [
   "多谢。",
   "不，哪里的话。",
   "我还在见习的时候",
   "曾受教于雷奈斯骑士团的赛特将军。",
   "即使武艺未成，也有拯救同伴的",
   "重要职责——将军这样说过……",
   "啊……？",
   "怎么了？",
   "那、那个骑影是……赛特将军！？",
   "而且，那位是……",
   "艾莉卡大人！"
  ],
  "2291": [
   "您、您没事吧，吉利亚姆大人？",
   "擦伤而已。",
   "对、对了，我身上带着",
   "伤药！",
   "我现在就给您送过去！"
  ],
  "2292": [
   "找到了！是雷奈斯的残党。",
   "别让他跑了！"
  ],
  "2293": [
   "啧，一个两个",
   "都是废物！"
  ],
  "2294": [
   "什、什么……",
   "我竟然……"
  ],
  "2297": [
   "艾莉卡大人",
   "您平安无事，太好了！",
   "弗朗茨，你也平安无事……",
   "是、是！",
   "我在弗雷利亚领遇到吉利亚姆大人，",
   "正在向他说明情况……",
   "那时听说国境的米乌兰城里",
   "弗雷利亚公主塔娜大人有危险，",
   "便慌忙与吉利亚姆大人赶来这里……",
   "塔娜在这里……？",
   "弗朗茨，快走吧。",
   "是！"
  ],
  "2298": [
   "弗朗茨啊，你平安无事。",
   "是、是……赛特将军也……",
   "只要有将军在，",
   "我们雷奈斯骑士团绝不会输！",
   "弗朗茨，与我一同",
   "守护艾莉卡大人。",
   "出发。",
   "是，将军！"
  ],
  "2299": [
   "古拉德军那些家伙",
   "好像已经压制了城堡。",
   "待在城门上还能回血，",
   "守起来很方便。",
   "反过来说，要攻下",
   "就相当困难了……"
  ],
  "2300": [
   "占据那座城的",
   "重装骑士……",
   "似乎穿着相当坚固的",
   "铠甲。",
   "用普通武器的话",
   "很难打倒吧。",
   "记得用刺剑或破甲剑这类武器",
   "就能造成很大伤害。"
  ],
  "2301": [
   "剑",
   "・",
   "枪",
   "・",
   "斧",
   "之间",
   "相克",
   "就是这样的关系。",
   "枪",
   "克",
   "剑，",
   "而",
   "剑",
   "克",
   "斧，",
   "而",
   "斧",
   "克",
   "枪",
   "。",
   "在刚才的战斗中",
   "敌将布雷格是",
   "枪",
   "弗雷利亚兵是",
   "剑",
   "。",
   "枪",
   "克",
   "剑，",
   "所以",
   "敌将布雷格占优。",
   "要打赢战斗，",
   "相克",
   "非常重要。",
   "首先",
   "枪",
   "克",
   "剑",
   "这一点",
   "也请",
   "记住。"
  ],
  "2302": [
   "去",
   "『访问』",
   "民居吧。",
   "首先把光标移到艾莉卡身上，",
   "按Ａ键。"
  ],
  "2303": [
   "艾莉卡",
   "抓起来。",
   "请按Ａ键。"
  ],
  "2304": [
   "让艾莉卡",
   "民居",
   "前往",
   "。",
   "把光标移到闪烁的位置，",
   "按Ａ键。"
  ],
  "2305": [
   "在民居里",
   "战斗提示",
   "和",
   "村民的闲谈等，各种",
   "情报都能打听到。",
   "很有参考价值，",
   "看到的话",
   "请去访问看看。",
   "那么",
   "『访问』",
   "选择",
   "并按Ａ键。"
  ],
  "2306": [
   "城门",
   "和",
   "堡垒",
   "等",
