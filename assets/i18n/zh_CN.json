  "2098": [
   "推荐初次游玩的人。",
   "游戏的操作方法等",
   "玩法会有",
   "浅显易懂的",
   "说明。"
  ],
  "2099": [
   "推荐玩过一次",
   "『新手』的人。",
   "操作方法等玩法",
   "没有说明，",
   "敬请注意。"
  ],
  "2100": [
   "推荐追求硬派战棋",
   "的人。没有玩法",
   "说明，游戏难度",
   "设定得比较",
   "高。"
  ],
  "2243": [
   "禀、禀报！",
   "城门已被攻破！",
   "维加尔德皇帝率领的古拉德军",
   "已经侵入城内！",
   "是吗……",
   "我军守备队已经崩溃……",
   "与前线艾夫拉姆大人的联络也已中断，",
   "援军指望不上了……",
   "陛下，这样下去……！",
   "……",
   "到此为止了。",
   "传令全军士兵投降。"
  ],
  "2244": [
   "父王……",
   "艾莉卡。",
   "我赐予你的手环，",
   "还戴在身上吧？",
   "是，在这里……",
   "嗯……",
   "赛特。",
   "在。",
   "带上艾莉卡，逃往弗雷利亚。",
   "去投靠弗雷利亚王海登。",
   "他定会护你们周全。",
   "遵命。",
   "那陛下您……",
   "我留在这里。",
   "与我军结盟的古拉德帝国",
   "为何会做出这等暴行……",
   "我必须弄清他们的真意。",
   "雷奈斯的灭亡，等于是我招来的。",
   "与国同命，是这愚王的本分。",
   "怎么会……父王！",
   "若父王要留下，",
   "那我也一起……！",
   "走，赛特。"
  ],
  "2245": [
   "父王！",
   "恕罪，艾莉卡大人。"
  ],
  "2246": [
   "艾夫拉姆，艾莉卡……",
   "你们绝不能死。"
  ],
  "2251": [
   "呃……",
   "！"
  ],
  "2252": [
   "哦？受了那伤还能动。",
   "有意思……",
   "逃吧逃吧。",
   "拼了命地逃窜吧。",
   "让我们这场愉快的游戏",
   "能多拖一会儿也好啊？"
  ],
